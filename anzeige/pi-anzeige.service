[Unit]
Description=Info-Anzeige auf dem 3,5-Zoll-Display (Uhr, Wetter, Pi-hole)
After=network-online.target pihole-FTL.service time-sync.target
Wants=network-online.target

[Service]
User=anzeige
Group=anzeige
SupplementaryGroups=video pihole
# Text-Konsole vom Display lösen, damit sie nicht über die Anzeige schreibt;
# beim Beenden zurückgeben, dann erscheint wieder die Login-Konsole.
ExecStartPre=+/bin/sh -c 'echo 0 > /sys/class/vtconsole/vtcon1/bind'
ExecStart=/usr/bin/python3 /opt/pi-anzeige/anzeige.py
ExecStopPost=+/bin/sh -c 'echo 1 > /sys/class/vtconsole/vtcon1/bind'
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
